{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "rozkalns-control",
  "main": "./src/worker/index.ts",
  "compatibility_date": "2026-08-10",
  "compatibility_flags": ["nodejs_compat"],
  "workers_dev": false,
  "preview_urls": false,
  "upload_source_maps": true,
  "observability": {
    "enabled": true
  },
  "vars": {
    "GITHUB_APP_CLIENT_ID": "Iv23likDoFtVeWBJfdFS",
    "GITHUB_APP_INSTALLATION_ID": "153121564"
  },
  "secrets": {
    "required": ["GITHUB_APP_PRIVATE_KEY_PEM"]
  },
  "d1_databases": [
    {
      "binding": "CONTROL_DB",
      "database_name": "rozkalns-control-production",
      "database_id": "8504e986-faf0-450c-bfb5-41b5dbf8be09",
      "migrations_dir": "migrations"
    }
  ],
  "assets": {
    "directory": "./dist/client",
    "not_found_handling": "single-page-application"
  }
}
