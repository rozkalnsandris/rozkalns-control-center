{
  "version": 1,
  "target": {
    "repository": "rozkalnsandris/rozkalns-control-center",
    "environment": "production-worker-deploy",
    "secret": "CONTROL_ACCESS_CLIENT_SECRET"
  },
  "source_policy": {
    "dispatch_ref": "main",
    "exact_main_sha_required": true,
    "owner_authorization_required": true
  },
  "input_policy": {
    "plaintext_secret_forbidden": true,
    "encrypted_value_required": true,
    "key_id_required": true,
    "current_key_id_match_required": true
  },
  "mutation_policy": {
    "maximum_put_requests": 1,
    "retry_after_put_started": false,
    "rollback_after_put_started": false,
    "cleanup_after_put_started": false,
    "fail_closed_on_ambiguous_result": true
  },
  "post_update_policy": {
    "deploy_environment_get_only_verification_required": true,
    "worker_deploy_requires_separate_owner_authorization": true,
    "hermes_live_requires_separate_owner_authorization": true
  }
}
