    "scheduled_tasks_paid_plan_max_frequency": "PT1H",
    "event_triggered_tasks_max_runs_per_hour": 30,
    "event_triggered_tasks_max_runs_per_day": 720,
    "github_event_triggered_work_supported_for_pull_request_activity": true,
