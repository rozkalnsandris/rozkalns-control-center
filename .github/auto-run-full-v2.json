{
  "schema_version": 5,
  "policy": "AUTO-RUN FULL v2",
  "repository": "rozkalnsandris/rozkalns-control-center",
  "enablement_issue": 498,
  "controller_issue": 499,
  "lane_role": {
    "normal_implementation_lane": "AUTO-RUN FULL",
    "safe_discovery_lane": "FAST-LANE v2.2",
    "fast_lane_may_infer_auto_run_full": false
  },
  "command": {
    "canonical_prefix": "AUTO-RUN FULL",
    "syntax": "AUTO-RUN FULL rozkalns-control-center #<issue>",
    "requires_explicit_current_command": true,
    "requires_exact_repository": true,
    "requires_exact_open_issue": true,
    "may_be_inferred_from_context": false,
