    "stable_receipt_required_before": [
      "CONTROLLER_WORKING_POINTER_WRITE",
      "BRANCH_CREATE",
      "SOURCE_FILE_WRITE",
      "COMMIT_OR_PUSH",
      "PR_CREATE_OR_UPDATE",
      "MERGE",
      "RUNTIME_OR_LIVE_MUTATION"
    ],
    "post_receipt_main_revalidation_required": true,
    "post_receipt_main_stability": {
      "barrier": "READ_MAIN_M0__WRITE_RECEIPT_M0__READ_MAIN_M1__REQUIRE_M1_EQUALS_M0",
      "stable_when": "POST_WRITE_MAIN_SHA_EQUALS_RECEIPT_ACTIVATION_MAIN_SHA",
      "only_latest_stable_receipt_is_authoritative_for_source_and_merge": true,
      "stale_receipt_never_authorizes_source_or_merge": true,
      "main_only_drift_consumes_owner_authorization": false,
      "main_only_drift_requires_new_owner_command": false,
      "max_consecutive_inline_stabilization_attempts": 3,
      "after_attempt_limit_state": "PAUSED_EXTERNAL",
      "paused_controller_pointer_allowed_after_receipt": true,
      "paused_controller_pointer_is_source_authority": false,
      "resume_must_establish_stable_receipt_before_source": true,
      "scope_or_rule_drift_is_not_main_only_drift": true
    },
    "main_drift_before_source_recovery": {
      "allowed": true,
      "requires_no_branch_source_commit_pr_merge_runtime_or_live_mutation": true,
      "requires_fresh_revalidation": [
        "exact_target_issue_is_still_open",
        "target_issue_scope_is_identical_to_frozen_scope",
        "repository_rules_and_policy_are_compatible_with_frozen_scope",
        "controller_points_to_no_other_issue",
        "no_branch_source_commit_pr_merge_runtime_or_live_mutation_occurred",
        "current_main_active_pr_ci_review_and_dependencies_are_freshly_re_read"
      ],
      "old_receipt_is_immutable_audit_record": true,
      "old_receipt_must_not_be_deleted_or_edited": true,
      "superseding_receipt_required": true,
      "supersession_reason": "MAIN_DRIFT_BEFORE_SOURCE",
      "superseding_receipt_must_preserve_frozen_scope": true,
      "latest_superseding_receipt_must_pass_post_write_main_revalidation": true,
      "mismatch_after_prohibited_mutation_requires_stop": true
    },
    "later_issue_edits_do_not_expand_authority": true,
    "new_scope_requires_stop": true
  },
  "allowed_without_further_owner_nudge": [
    "FRESH_GITHUB_READS",
    "SOURCE_ANALYSIS",
    "SOURCE_DOC_TEST_POLICY_CHANGES",
    "BRANCH_CREATE",
    "EXACT_PATH_COMMITS",
    "PUSH",
    "PR_CREATE_OR_UPDATE",
    "CI_WAIT_AND_INSPECTION",
    "REVIEW_INGESTION",
    "SCOPE_PRESERVING_CORRECTIVE_COMMITS",
    "MERGE_CONFLICT_RESOLUTION_WITHOUT_HISTORY_REWRITE",
    "FINAL_EXACT_HEAD_REVIEW",
    "ARM_NATIVE_AUTO_MERGE_ONLY_WHEN_HEAD_IS_FROZEN_AND_REQUIRED_GATES_ARE_STILL_PENDING",
    "DIRECT_EXACT_HEAD_SQUASH_MERGE_WHEN_PR_IS_ALREADY_IMMEDIATELY_MERGEABLE",
    "POST_MERGE_READ_ONLY_REVALIDATION",
    "FINAL_GITHUB_RECEIPTS"
  ],
  "strict_live_never_implied": [
    "PRODUCTION_WORKER_UPLOAD_DEPLOY_OR_PROMOTION",
    "PRODUCTION_DATABASE_WRITE_OR_MIGRATION",
    "PRODUCTION_D1_DATA_MUTATION",
    "QUEUE_WRITE_REPLAY_OR_CONFIGURATION_MUTATION",
    "LIVE_CONTROL_MERGE_NEEDS_CHANGES_LATER_OR_OTHER_DECISION_ACTION",
    "LIVE_CONTROL_CANARY_OR_EXECUTOR_INVOCATION_WITH_WRITE_EFFECTS",
    "GITHUB_APP_PERMISSION_OR_REPOSITORY_SELECTION_CHANGE",
    "GITHUB_REPOSITORY_SETTINGS_RULESET_OR_BRANCH_PROTECTION_CHANGE",
    "CLOUDFLARE_DNS_ACCESS_TUNNEL_DOMAIN_BINDING_OR_INFRASTRUCTURE_MUTATION",
    "SECRET_CREDENTIAL_OR_TOKEN_CHANGE",
    "RPI5_ROOT_SUDO_SYSTEMD_DOCKER_NETWORK_OR_HOST_MUTATION",
    "DESTRUCTIVE_CLEANUP",
    "UNDECLARED_RETRY_ROLLBACK_OR_ALTERNATE_MUTATION_PATH"
  ],
  "never_implied": [
    "UNRELATED_ISSUE_OR_REPOSITORY_WORK",
    "RESET_REBASE_FORCE_OR_HISTORY_REWRITE",
    "PROVIDER_API_KEY",
    "TOKEN_BILLED_LLM_FALLBACK",
    "AUTOMATIC_PAID_CREDIT_PURCHASE"
  ],
  "merge": {
    "auto_run_full_command_is_explicit_owner_merge_authority_for_the_frozen_issue": true,
    "strategy": "HYBRID_EXACT_HEAD_V2",
    "canonical_pr_only": true,
    "source_head_must_be_frozen_before_any_merge_mechanism": true,
    "fresh_exact_head_revalidation_required": true,
    "final_diff_scope_review_required": true,
    "required_ci_and_review_policy_must_be_fresh": true,
    "unresolved_actionable_review_findings_must_be_zero_before_direct_merge": true,
    "mergeability_must_be_fresh": true,
    "changed_head_invalidates_previous_merge_readiness": true,
    "when_immediately_mergeable": "DIRECT_SQUASH_WITH_EXPECTED_HEAD_SHA",
    "when_blocked_only_by_required_gates_and_head_is_frozen": "ENABLE_GITHUB_AUTO_MERGE_IF_REPOSITORY_CAPABILITY_AVAILABLE",
    "native_auto_merge_is_not_attempted_for_already_clean_immediately_mergeable_pr": true,
    "native_auto_merge_must_not_be_armed_while_source_corrections_remain_possible": true,
    "source_push_after_native_auto_merge_arm": false,
    "correction_after_native_auto_merge_arm_requires_disable_before_push": true,
    "if_safe_auto_merge_disable_is_unavailable_or_ambiguous": "STOP_ERROR",
    "direct_merge_requires_expected_head_sha": true,
    "repository_ruleset_bypass": false,
    "force_merge": false,
    "merge_authorizes_live_mutation": false
  },
  "live": {
    "auto_run_full_command_is_live_authority": false,
    "separate_explicit_owner_live_authorization_required": true,
    "existing_issue_1_issue_278_and_phase_specific_live_contracts_remain_authoritative": true,
    "source_work_may_converge_before_live_gate": true,
    "state_when_definition_of_done_requires_unapproved_strict_live": "PAUSED_OWNER_LIVE_GATE",
    "new_live_mutation_class_after_activation": "STOP_SCOPE_OR_RISK",
    "post_live_mutation_error_without_predeclared_recovery": "STOP_ERROR"
  },
  "states": [
    "IDLE",
    "ACTIVATING",
    "WORKING",
    "WAITING_CI",
    "WAITING_REVIEW",
    "CORRECTING",
    "WAITING_EVENT_RESUME",
    "WAITING_WATCHDOG_RESUME",
    "PAUSED_USAGE",
    "PAUSED_PLATFORM_APPROVAL",
    "PAUSED_EXTERNAL",
    "PAUSED_OWNER_LIVE_GATE",
    "VERIFYING",
    "DONE",
    "STOP_SCOPE_OR_RISK",
    "STOP_ERROR"
  ],
  "continuation": {
    "routine_ci_failure_is_owner_gate": false,
    "review_finding_is_owner_gate": false,
    "ordinary_merge_conflict_is_owner_gate": false,
    "session_or_turn_end_is_owner_gate": false,
    "event_triggered_run_reconstructs_from_github": true,
    "scheduled_watchdog_reconstructs_from_github": true,
    "usage_exhaustion": "PAUSED_USAGE",
    "platform_required_app_approval": "PAUSED_PLATFORM_APPROVAL",
    "external_wait": "PAUSED_EXTERNAL",
    "identical_failure_retry_ceiling": 3,
    "retry_requires_materially_new_hypothesis_after_repeat": true
