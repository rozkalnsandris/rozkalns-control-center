{
  "name": "rozkalns-control-center",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": "24.19.0"
  },
  "devEngines": {
    "runtime": {
      "name": "node",
      "version": "24.19.0",
      "onFail": "error"
    }
  },
  "scripts": {
    "dev": "vite",
    "verify:node": "node scripts/verify-node-version.mjs",
    "cf-typegen": "wrangler types",
    "typecheck": "wrangler types && tsc -b --pretty false",
    "lint": "eslint . --max-warnings=0",
    "test": "rm -rf .tmp-tests && tsc -p tsconfig.test.json && node --experimental-sqlite --test .tmp-tests/tests/*.test.js",
    "test:browser": "node tools/browser-ui-regression.mjs",
    "build": "wrangler types && tsc -b && vite build",
    "cf:dry-run": "wrangler deploy --dry-run --outdir .wrangler-dry-run",
    "cf:first-version-gate": "node scripts/cloudflare-first-version-gate.mjs",
    "cf:second-version-gate": "node scripts/cloudflare-second-version-gate.mjs",
    "cf:d1-migration-gate": "node scripts/cloudflare-d1-migration-gate.mjs",
    "cf:needs-changes-d1-migration-gate": "node scripts/cloudflare-needs-changes-d1-migration-gate.mjs",
    "cf:ui-deploy-gate": "node scripts/cloudflare-ui-deploy-gate.mjs",
    "cf:ui-domain-gate": "node scripts/cloudflare-ui-domain-gate.mjs",
    "cf:queue-usage-observation": "node scripts/cloudflare-queue-usage-observation.mjs",
    "github:needs-changes-preflight": "node scripts/github-app-needs-changes-preflight.mjs",
    "test:audit-runtime": "node --test scripts/npm-audit-runtime.test.mjs scripts/github-advisory-fallback.test.mjs",
    "audit:runtime": "npm run test:audit-runtime && node scripts/npm-audit-runtime.mjs",
    "verify:actions": "node scripts/verify-actions-pinning.mjs",
    "verify:public": "node scripts/verify-public-repo-safety.mjs",
    "verify:policy": "npm run verify:actions && npm run verify:public",
    "check": "node scripts/run-check-sanitized.mjs"
  },
  "dependencies": {
    "react": "19.2.1",
    "react-dom": "19.2.1"
  },
  "devDependencies": {
    "@cloudflare/vite-plugin": "1.51.1",
    "@eslint/js": "9.39.1",
    "@types/node": "24.10.1",
    "@types/react": "19.2.7",
    "@types/react-dom": "19.2.3",
    "@vitejs/plugin-react": "6.0.5",
    "eslint": "9.39.2",
    "eslint-plugin-react-hooks": "7.0.1",
    "eslint-plugin-react-refresh": "0.4.24",
    "globals": "16.5.0",
    "typescript": "5.9.3",
    "typescript-eslint": "8.48.0",
    "vite": "8.2.1",
    "wrangler": "4.120.0"
  }
}
